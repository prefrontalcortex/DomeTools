<?xml version="1.0" encoding="utf-8"?>
<!-- Unencrypted http is only allowed to this device itself: the file picker streams picked
     videos to the video player from a local server (see DomeViewerFilePicker.java). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
